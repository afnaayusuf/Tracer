              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Controls"
        },
        "controls_status": {
          "default": "unknown",
          "enum": [
            "unknown",
            "hypothesis",
            "fact"
          ],
          "title": "Controls Status",
          "type": "string"
        },
        "confidence": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "box"
      ],
      "title": "Actuator",
      "type": "object"
